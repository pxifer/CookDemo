# Explicit loading: scripts/run.ps1 start -EnvFile .env.local
# For generated database/secret files, run scripts/setup-local.ps1 instead.
APP_ENV=local
HOST=127.0.0.1
PORT=4175
APP_ORIGIN=http://127.0.0.1:4175
LOCAL_TEST_FEATURES=0
CONTENT_SOURCE=constructed
ACCOUNTS_ENABLED=0
MODEL_ENABLED=0
# MODEL_ENABLED=1 requires PostgreSQL invocation ledger, session secrets and explicit provider/model.
# Provisional provider: DeepSeek; API calls can consume balance and remain disabled.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
# Explicitly use your server-side personal API key before enabling; no platform-paid mode.
# MODEL_FEE_MODE=byok
# MODEL_API_KEY_FILE=<absolute path to a server-side secret file>
# MODEL_TIMEOUT_MS=15000
# MODEL_QUOTA_BUCKET=health-query-v1
# See docs/HEALTH-MODEL-API.md for ledger quota setup and CloudBase boundary.
SEMANTIC_SEARCH_ENABLED=0
HEALTH_ENABLED=0

# Image recognition: reuse account DeepSeek key, or configure free Zhipu vision on server.
IMAGE_MODEL_PROVIDER=auto
# IMAGE_ZHIPU_API_KEY=
