  "facts": [
    {
      "id": "thyroid-autoimmune-seaweed",
      "section": "能否吃",
      "statement": "不能只凭“甲减”一律判定能吃或禁吃海带。若属于桥本等自身免疫性甲状腺病，大量高碘海藻或自行补碘可能造成不利影响；应先确认病因和医生给出的限碘要求。",
      "evidenceIds": [
        "topic-ev:0f921b012a56f846446752eae71381336382ed5d2d51a0c8ac7c601bef33a4cc"
      ],
      "qualifyingEvidenceIds": [
        "topic-ev:395aa2d8c5b484b2786d6d8e25a4b9c73484cd6708075b5e589ac9f1ce536783"
      ],
      "conditions": [
        "仅描述自身免疫性甲状腺病的高碘风险，不推断所有甲减均缺碘或均需低碘"
      ],
      "kind": "conditional_explanation"
    },
    {
      "id": "thyroid-food-source-context",
      "section": "食材选择",
      "statement": "鱼虾、蛋类和奶类也属于含碘食物来源，不必把补碘等同于必须吃海带。这里是食物来源信息，不是甲减宜吃清单；是否适合或需要限制，应结合病因、过敏和个体饮食方案。",
      "evidenceIds": [
        "topic-ev:07436df0804efb521d14c9caba582ad60d135d0f7c9d8548cef4f839c151d8cd"
      ],
      "qualifyingEvidenceIds": [
        "topic-ev:395aa2d8c5b484b2786d6d8e25a4b9c73484cd6708075b5e589ac9f1ce536783",
        "topic-ev:0f921b012a56f846446752eae71381336382ed5d2d51a0c8ac7c601bef33a4cc"
      ],
      "conditions": [
        "公共食物来源知识，不能转成甲减患者应增加摄入的指令"
      ],
      "kind": "food_source_context_only"
    },
    {
      "id": "thyroid-pregnancy-qualifier",
      "section": "特殊条件",
      "statement": "妊娠期既要考虑足够的碘，也不能过量；不能把普通甲减或海带限量建议直接套用，应由医生明确个人碘需要。",
      "evidenceIds": [
        "topic-ev:8bc222fb2f9b8f4c3d577f551c5d18336a17ef3ea9b8da084c391a55a20ca337"
      ],
      "qualifyingEvidenceIds": [],
      "conditions": [
        "妊娠相关限定，不据此开补充剂或营养处方"
      ],
      "kind": "exception"
    },
    {
      "id": "thyroid-supplement-boundary",
      "section": "补充剂",
      "statement": "不能把正在研究的硒或维生素D补充推成桥本患者已有明确适用方案，不给出自行补充剂量。",
      "evidenceIds": [
