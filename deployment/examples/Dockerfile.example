# Documentation template, NOT a production-ready deployment.
# First implement HOST support and the production gates described in the guide.
# Build context: CookDemo repository root.
# A Dockerfile-specific ignore file is supplied beside this file.
FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY frontend ./frontend
COPY shared ./shared
COPY backend ./backend
COPY datasets ./datasets
COPY scripts/generate-validation.ts ./scripts/generate-validation.ts
COPY tsconfig.json vite.config.ts ./
RUN npm run build
ENV NODE_ENV=production
ENV LOCAL_TEST_FEATURES=0
ENV HOST=0.0.0.0
ENV PORT=8080
EXPOSE 8080
USER node
# Current npm start uses tsx, which is a devDependency: retain it in this template.
# Do not use npm ci --omit=dev without first changing the server build/start path.
CMD ["npm", "start"]
