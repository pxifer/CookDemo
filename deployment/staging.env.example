# Non-secret settings for a structural staging deployment; cloud admission is still required.
APP_ENV=staging
HOST=0.0.0.0
PORT=8080
APP_ORIGIN=https://replace-with-actual-approved-domain.example
LOCAL_TEST_FEATURES=0
CONTENT_SOURCE=pending
DB_POOL_MAX=4
DB_CONNECT_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=5000
DB_REQUIRE_VECTOR=1
DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_CA_FILE=/run/secrets/database_ca
SESSION_SECRET_B64_FILE=/run/secrets/session_secret
CSRF_SECRET_B64_FILE=/run/secrets/csrf_secret
ACCOUNTS_ENABLED=0
MODEL_ENABLED=0
SEMANTIC_SEARCH_ENABLED=0
HEALTH_ENABLED=0
