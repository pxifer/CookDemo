{
  "name": "shiwei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "tsx scripts/generate-validation.ts && tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "db:prepare": "tsx scripts/prepare-local.ts",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:check": "tsx scripts/database.ts check",
    "test:postgres": "tsx --test tests/postgres.integration.ts",
    "test:business:postgres": "tsx --test tests/business-postgres.integration.ts",
    "test:business:e2e": "playwright test --config playwright.business.config.ts",
    "test:ui:e2e": "playwright test --config playwright.ui.config.ts",
    "test:resume:e2e": "playwright test --config playwright.resume.config.ts",
    "db:cloudbase:prepare": "tsx scripts/build-cloudbase-migrations.ts",
    "test:cloudbase": "tsx --test tests/cloudbase-migrations.integration.ts",
    "capture:evidence": "tsx scripts/capture-evidence.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
